# Only for the reverse proxy setup (docker-compose.yml). setup.sh writes its own.
# Copy to deploy/.env and fill in. Never commit the .env.
TURN_SECRET=          # openssl rand -hex 32 (the same goes in turnserver.conf)
TURN_HOST=            # site domain, e.g. telinha.example.com
PUBLIC_IP=            # public IP of the VPS (coturn)
PROXY_NETWORK=        # existing Docker network of the reverse proxy (Caddy)
CADDY_CERTS=          # caddy/certificates folder inside the Caddy data volume
# Optional: how many reverse proxies are in front of the server (default 1).
# With a CDN or a second proxy before yours, set 2, or the limit below counts
# every visitor as one address.
# TRUST_PROXY=1
# Optional: relay credentials one address may ask for every ten minutes (default 60).
# ICE_LIMIT=60
