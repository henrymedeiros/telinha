// TELINHA_VERSION (0.5.2) and TELINHA_VERSION_NUMBERS (0,5,2,0) come from build.rs.
#define TELINHA_STR2(x) #x
#define TELINHA_STR(x) TELINHA_STR2(x)

1 ICON "../icons/telinha.ico"

1 VERSIONINFO
FILEVERSION TELINHA_VERSION_NUMBERS
PRODUCTVERSION TELINHA_VERSION_NUMBERS
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "Telinha"
      VALUE "FileDescription", "Telinha: transmissão de tela de baixa latência"
      VALUE "ProductName", "Telinha"
      VALUE "FileVersion", TELINHA_STR(TELINHA_VERSION)
      VALUE "ProductVersion", TELINHA_STR(TELINHA_VERSION)
      VALUE "OriginalFilename", "telinha.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
